JWT_SECRET=change-me-in-any-non-demo-environment-32b
JWT_EXPIRE_MINUTES=120
API_HOST=127.0.0.1
API_PORT=8000

# openai | groq | ollama | openrouter | auto | none
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2

SCRAPERAPI_KEY=

# Vector store: pinecone (Railway) or pgvector (local docker)
VECTOR_BACKEND=auto
PINECONE_API_KEY=
PINECONE_INDEX_NAME=rag-chunks
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Railway: Postgres catalog only when using Pinecone.
# When this is set, POSTGRES_* / PGVECTOR_* below are ignored.
DATABASE_URL=
DATA_DIR=
API_URL=http://127.0.0.1:8000

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag_app

PGVECTOR_HOST=127.0.0.1
PGVECTOR_PORT=5433
PGVECTOR_USER=rag
PGVECTOR_PASSWORD=rag
PGVECTOR_DB=rag_vectors

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_K=5
